{
  "name": "@conkernftz/storage",
  "version": "4.0.0",
  "description": "Pluggable storage providers (Irys/Arweave, Pinata IPFS via JWT, local) + file manager",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js"
    },
    "./file-manager": {
      "types": "./dist/file-manager.d.ts",
      "import": "./dist/file-manager.js",
      "require": "./dist-cjs/file-manager.js"
    }
  },
  "files": [
    "dist",
    "dist-cjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/postbuild.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist dist-cjs"
  },
  "dependencies": {}
}
