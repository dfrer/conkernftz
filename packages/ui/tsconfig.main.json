{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "@conkernftz/storage/file-manager": ["node_modules/@conkernftz/storage/dist/file-manager.d.ts"]
    },
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "src/main.ts",
    "src/main/**/*"
  ],
  "exclude": ["src/renderer/**/*", "src/design-system/**/*"]
}
