{
  "name": "@conkernftz/ui",
  "version": "4.0.0",
  "private": true,
  "description": "Electron GUI for conkernftz",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "pnpm run build:ts && pnpm run build:renderer-next && pnpm run build:site && pnpm run build:console && pnpm run build:assets",
    "build:ts": "tsc -p tsconfig.main.json",
    "build:renderer-next": "vite build",
    "build:site": "vite build --config vite.site.config.ts",
    "build:console": "vite build --config vite.console.config.ts",
    "build:assets": "node scripts/copy.js",
    "dev:renderer-next": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer-next.json --noEmit",
    "start": "node scripts/start.cjs",
    "screenshots": "node scripts/screenshots.mjs",
    "qa": "node scripts/qa-driver.mjs",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@conkernftz/chain-evm": "workspace:^",
    "@conkernftz/chain-solana": "workspace:*",
    "@conkernftz/core": "workspace:*",
    "@conkernftz/storage": "workspace:*",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@walletconnect/ethereum-provider": "^2.23.10",
    "execa": "^9.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.55.17"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "happy-dom": "^20.11.2",
    "playwright-core": "^1.62.1",
    "vite": "^8.2.1"
  }
}
