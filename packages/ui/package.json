{
  "name": "@conkernftz/ui",
  "version": "4.0.0",
  "private": true,
  "description": "Electron GUI for conkernftz",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "pnpm run build:ts && pnpm run build:renderer-next && pnpm run build:site && pnpm run build:assets",
    "build:ts": "tsc -p tsconfig.main.json",
    "build:renderer-next": "vite build",
    "build:site": "vite build --config vite.site.config.ts",
    "build:assets": "node scripts/copy.js",
    "dev:renderer-next": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer-next.json --noEmit",
    "start": "node scripts/start.cjs",
    "screenshots": "node scripts/screenshots.mjs",
    "clean": "rimraf dist",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@conkernftz/chain-solana": "workspace:*",
    "@conkernftz/core": "workspace:*",
    "@conkernftz/storage": "workspace:*",
    "@fontsource-variable/archivo": "^5.1.1",
    "@fontsource/ibm-plex-mono": "^5.1.1",
    "@fontsource/ibm-plex-sans": "^5.1.1",
    "execa": "^9.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^31.3.0",
    "happy-dom": "^15.11.6",
    "playwright-core": "^1.61.0",
    "vite": "^5.4.11"
  }
}
