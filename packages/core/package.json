{
  "name": "@conkernftz/core",
  "version": "4.0.0",
  "description": "Core compositing engine, rarity, DNA, rule engine, preview",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./project-config": {
      "types": "./dist/project-config.d.ts",
      "default": "./dist/project-config.js"
    },
    "./project-build": {
      "types": "./dist/project-build.d.ts",
      "default": "./dist/project-build.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./generator": {
      "types": "./dist/generator.d.ts",
      "default": "./dist/generator.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist"
  },
  "sideEffects": false,
  "dependencies": {
    "@noble/hashes": "^1.4.0",
    "ffmpeg-static": "^5.3.0",
    "gifenc": "^1.0.3",
    "sharp": "^0.33.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "pixelmatch": "^7.2.0"
  }
}
