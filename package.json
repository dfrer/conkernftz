{
  "name": "conkernftz",
  "private": true,
  "version": "4.0.0",
  "description": "conkernftz – Next-gen open-source NFT art foundry (HashLips replacement)",
  "license": "MIT",
  "packageManager": "pnpm@9.1.0",
  "pnpm": {
    "overrides": {
      "@coinbase/cdp-sdk>axios": "1.18.0",
      "@solana/rpc-subscriptions-channel-websocket>ws": "8.21.3",
      "@walletconnect/jsonrpc-ws-connection>ws": "7.5.11",
      "jayson>ws": "7.5.11"
    }
  },
  "engines": {
    "node": ">=22.14.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "build:cli": "pnpm -C packages/cli run build",
    "build:core": "pnpm -C packages/core run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test --concurrency=1",
    "test:coverage": "turbo run test:coverage --concurrency=1",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "cli": "pnpm -C packages/cli start",
    "app": "pnpm -C packages/ui start",
    "scrape:fal": "node scripts/scrape-fal-models.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.20.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.10",
    "puppeteer": "^25.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
