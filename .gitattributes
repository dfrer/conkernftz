# Ensure LF line endings in text; keep binary as-is
* text=auto eol=lf

# Windows batch/cmd files must keep CRLF line endings to run reliably
*.bat text eol=crlf
*.cmd text eol=crlf

# Treat common binary types explicitly
*.png binary
*.ico binary
*.icns binary
*.exe binary
*.dll binary
*.wasm binary


