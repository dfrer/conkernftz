{
  "name": "@conkernftz/storage",
  "version": "5.0.0",
  "description": "Pluggable uploaders (Arweave Bundlr, IPFS)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
