    "clean": "rimraf dist"
  },
  "dependencies": {
    "@irys/upload": "^0.0.15",
    "@irys/upload-ethereum": "^0.0.16",
    "@irys/upload-solana": "^0.1.8",
    "bs58": "^6.0.0",
    "mime": "^4.0.4",
    "pinata": "^2.5.6"
  }
}


