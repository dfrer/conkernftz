{
  "name": "@foundry/ui",
  "version": "3.0.0",
  "private": true,
  "description": "Electron GUI for conkernftz CLI",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "pnpm run build:ts && pnpm run build:assets",
    "build:ts": "tsc -p tsconfig.json",
    "build:assets": "node scripts/copy.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "execa": "^9.4.0",
    "@foundry/storage": "workspace:*"
  },
  "devDependencies": {
    "electron": "^31.3.0"
  }
}


